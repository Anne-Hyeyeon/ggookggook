{
  "expo": {
    "name": "꾹꾹",
    "slug": "ggookggook",
    "scheme": "ggookggook",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F8F8F7",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "kr.ggookggook.app",
      "supportsTablet": false
    },
    "android": {
      "package": "kr.ggookggook.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#F8F8F7"
      }
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-sqlite",
      "expo-image",
      "expo-notifications",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F8F8F7",
          "dark": {
            "backgroundColor": "#171614"
          }
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "kr.ggookggook.app.ExpoWidgetsTarget",
          "groupIdentifier": "group.kr.ggookggook.app",
          "widgets": [
            {
              "name": "GgookWidget",
              "displayName": "꾹꾹",
              "description": "최근 루틴과 지금 해 보기를 바로 열어요.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "GgookWidget",
              "label": "꾹꾹",
              "description": "최근 루틴과 지금 해 보기를 바로 열어요.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
